import wollok.game.*
import juego.*
import entidades.plantas.*
import entidades.zombies.*
import entidades.proyectiles.*
import managers.managerOleadas.*
import managers.managerDeSoles.ManagerDeSoles

// reemplaza al azar en los tests: siempre devuelve lo mismo, así los tests son repetibles
object dadoCargado {
    method numeroEntre(minimo, maximo) = minimo
    method unoDe(lista) = lista.first()
}

describe "zombies" {

    method initialize() {
        partida.crearManagers()
    }

    method ponerZombie(zombie) {
        game.addVisual(zombie)
        partida.managerZombies().agregarEntidad(zombie)
    }

    test "un zombie da un paso recién cuando pasan sus ticks" {
        const zombie = new Zombie(position = game.at(5, 2))
        9.times({ i => zombie.pasarTick() })
        assert.equals(game.at(5, 2), zombie.position())
        zombie.pasarTick()
        assert.equals(game.at(4, 2), zombie.position())
    }

    test "un zombie llega a la casa cuando pasa la primera columna" {
        const zombie = new Zombie(position = game.at(0, 2))
        10.times({ i => zombie.pasarTick() })
        assert.that(zombie.llegoALaCasa())
    }

    test "si hay una planta en su celda, el zombie la come en vez de caminar" {
        const nuez = new Nuez(position = game.at(4, 2))
        partida.managerPlantas().plantar(nuez)
        const zombie = new Zombie(position = game.at(4, 2))
        self.ponerZombie(zombie)
        partida.managerZombies().tick()
        assert.equals(240, nuez.vida())
        assert.equals(game.at(4, 2), zombie.position())
    }

    test "un zombie muerto ya no come y cuenta como matado" {
        const nuez = new Nuez(position = game.at(4, 2))
        partida.managerPlantas().plantar(nuez)
        self.ponerZombie(new Zombie(position = game.at(4, 2), vida = 0))
        partida.managerZombies().tick()
        assert.equals(250, nuez.vida())
        assert.equals(1, partida.zombiesMatados())
    }

    test "el zombie que llega a la casa no suma zombies matados" {
        self.ponerZombie(new Zombie(position = game.at(-1, 2)))
        partida.managerZombies().tick()
        assert.equals(0, partida.zombiesMatados())
    }
}

describe "plantas" {

    method initialize() {
        partida.crearManagers()
    }

    method ponerZombieEn(posicion) {
        const zombie = new Zombie(position = posicion)
        game.addVisual(zombie)
        partida.managerZombies().agregarEntidad(zombie)
        return zombie
    }

    test "el lanzaguisante dispara recién cuando le toca y si hay zombies en su fila" {
        partida.managerPlantas().plantar(new LanzaGuisante(position = game.at(1, 2)))
        self.ponerZombieEn(game.at(7, 2))
        9.times({ i => partida.managerPlantas().tick() })
        assert.notThat(partida.managerProyectiles().hayEntidades())
        partida.managerPlantas().tick()
        assert.that(partida.managerProyectiles().hayEntidades())
    }

    test "el lanzaguisante no dispara si no hay zombies en su fila" {
        partida.managerPlantas().plantar(new LanzaGuisante(position = game.at(1, 2)))
        self.ponerZombieEn(game.at(7, 3))
        10.times({ i => partida.managerPlantas().tick() })
        assert.notThat(partida.managerProyectiles().hayEntidades())
    }

    test "la repetidora pega el doble que el lanzaguisante" {
        const zombieA = new Zombie(position = game.at(5, 2), vida = 20)
        const zombieB = new Zombie(position = game.at(5, 3), vida = 20)
        new LanzaGuisante(position = game.at(1, 2)).proyectilAUsar().aplicarEfecto(zombieA)
        new Repetidora(position = game.at(1, 3)).proyectilAUsar().aplicarEfecto(zombieB)
        assert.equals(15, zombieA.vida())
        assert.equals(10, zombieB.vida())
    }

    test "la carnívora come a un solo zombie por vez y se queda masticando" {
        const carnivora = new PlantaCarnivora(position = game.at(1, 2))
        const primero = self.ponerZombieEn(game.at(1, 2))
        const segundo = self.ponerZombieEn(game.at(2, 2))
        carnivora.accionar(partida.managerPlantas())
        assert.that(primero.tieneQueMorir())
        assert.notThat(segundo.tieneQueMorir())
        assert.that(carnivora.estaMasticando())
    }

    test "la carnívora no come a los zombies que están lejos" {
        const carnivora = new PlantaCarnivora(position = game.at(1, 2))
        const lejos = self.ponerZombieEn(game.at(3, 2))
        carnivora.accionar(partida.managerPlantas())
        assert.notThat(lejos.tieneQueMorir())
        assert.notThat(carnivora.estaMasticando())
    }

    test "mientras mastica no come y cuando termina puede comer otro" {
        const carnivora = new PlantaCarnivora(position = game.at(1, 2))
        partida.managerPlantas().plantar(carnivora)
        carnivora.comer(new Zombie(position = game.at(1, 2)))
        const siguiente = self.ponerZombieEn(game.at(2, 2))
        18.times({ i => carnivora.pasarTick(partida.managerPlantas()) }) // termina de masticar
        assert.notThat(carnivora.estaMasticando())
        assert.notThat(siguiente.tieneQueMorir())
        5.times({ i => carnivora.pasarTick(partida.managerPlantas()) }) // le toca actuar de nuevo
        assert.that(siguiente.tieneQueMorir())
    }

    test "la patapum no explota si nadie la mordió" {
        const patapum = new Patapum(position = game.at(3, 2))
        partida.managerPlantas().plantar(patapum)
        const zombie = self.ponerZombieEn(game.at(3, 2))
        patapum.accionar(partida.managerPlantas())
        assert.notThat(zombie.tieneQueMorir())
        assert.that(partida.managerPlantas().hayPlantaEn(game.at(3, 2)))
    }

    test "la patapum explota cuando la muerden y desaparece" {
        const patapum = new Patapum(position = game.at(3, 2))
        partida.managerPlantas().plantar(patapum)
        const zombie = self.ponerZombieEn(game.at(3, 2))
        zombie.atacar(patapum)
        patapum.accionar(partida.managerPlantas())
        assert.that(zombie.tieneQueMorir())
        assert.notThat(partida.managerPlantas().hayPlantaEn(game.at(3, 2)))
    }

    test "una planta sin vida se saca del tablero" {
        const nuez = new Nuez(position = game.at(3, 2), vida = 0)
        partida.managerPlantas().plantar(nuez)
        partida.managerPlantas().tick()
        assert.notThat(partida.managerPlantas().hayPlantaEn(game.at(3, 2)))
    }
}

describe "proyectiles" {

    method initialize() {
        partida.crearManagers()
    }

    test "un proyectil que encuentra un zombie le pega y desaparece" {
        const zombie = new Zombie(position = game.at(5, 2))
        game.addVisual(zombie)
        partida.managerZombies().agregarEntidad(zombie)
        partida.managerProyectiles().agregarEntidad(new Proyectil(position = game.at(5, 2), daño = 5))
        partida.managerProyectiles().tick()
        assert.equals(5, zombie.vida())
        assert.notThat(partida.managerProyectiles().hayEntidades())
    }

    test "si no hay zombies el proyectil avanza" {
        const proyectil = new Proyectil(position = game.at(2, 2))
        partida.managerProyectiles().agregarEntidad(proyectil)
        partida.managerProyectiles().tick()
        assert.equals(game.at(3, 2), proyectil.position())
    }

    test "un proyectil que avanza hasta la celda de un zombie le pega en el mismo tick (no se cruzan)" {
        const zombie = new Zombie(position = game.at(3, 2))
        game.addVisual(zombie)
        partida.managerZombies().agregarEntidad(zombie)
        partida.managerProyectiles().agregarEntidad(new Proyectil(position = game.at(2, 2), daño = 5))
        partida.managerProyectiles().tick()
        assert.equals(5, zombie.vida())
        assert.notThat(partida.managerProyectiles().hayEntidades())
    }

    test "el proyectil helado hace daño y hace retroceder al zombie" {
        const zombie = new Zombie(position = game.at(5, 2))
        game.addVisual(zombie)
        new ProyectilHelado(position = game.at(5, 2), daño = 5).aplicarEfecto(zombie)
        assert.equals(5, zombie.vida())
        assert.equals(game.at(6, 2), zombie.position())
    }
}

describe "oleadas y soles" {

    method initialize() {
        partida.crearManagers()
    }

    test "la primera oleada trae un zombie común que entra por la última columna" {
        const oleadas = new Oleadas(managerZombies = partida.managerZombies(), azar = dadoCargado)
        oleadas.tick() // arranca la oleada 1: con el dado cargado trae 1 zombie
        oleadas.tick() // el zombie sale de la cola y entra al tablero
        assert.equals(1, oleadas.numeroDeOleada())
        assert.that(partida.managerZombies().hayZombieEn(game.at(game.width() - 1, 0)))
        assert.notThat(oleadas.hayEntidades())
    }

    test "cada cinco oleadas viene una horda con el doble de zombies" {
        const oleadas = new Oleadas(managerZombies = partida.managerZombies(), azar = dadoCargado)
        4.times({ i => oleadas.generarNuevaOleada() })
        assert.notThat(oleadas.esHorda())
        assert.equals(4, oleadas.cantidadDeZombies())
        oleadas.generarNuevaOleada()
        assert.that(oleadas.esHorda())
        assert.equals(10, oleadas.cantidadDeZombies())
    }

    test "cada tanto cae un sol en el pasto" {
        const soles = new ManagerDeSoles(azar = dadoCargado)
        2.times({ i => soles.tick() })
        assert.that(game.getObjectsIn(game.at(0, 0)).isEmpty())
        soles.tick()
        assert.equals(1, game.getObjectsIn(game.at(0, 0)).size())
    }
}
