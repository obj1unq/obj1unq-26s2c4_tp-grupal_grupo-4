import entidades.zombies.*
import entidades.plantas.*
import entidades.proyectiles.*
import tablero.*
import wollok.game.*

//Todos los manager
import managers.managerZombies.ManagerZobies
import managers.managerOleadas.Oleadas
import managers.managerProyectiles.ManagerProyectiles

program PvzGame {
  game.height(5)
  game.width(9)
  game.cellSize(100)
  // primero hay que dibujar el tablero para que no pise a las plantas y a los zombies visualmente
  tablero.dibujarTablero()
  //game.boardGround("background.png")

  const planta1 = new Planta(position = game.at(0,2))
  const managerzombies = new ManagerZobies()
  const managerproyectiles = new ManagerProyectiles()
  const oleada1 = new Oleadas(managerZombies = managerzombies)
  const proyectil1 = new Proyectil(position = game.at(1, 2))
  const zombie1 = new Zombie(position = game.at(8,2), velocidad= 1)
  oleada1.agregarCantidadEntidad(3, {i=> new Zombie(position = game.at(1,0), velocidad = i+3)})
  managerproyectiles.agregarEntidad(proyectil1)
  managerzombies.agregarEntidad(zombie1)




  game.addVisual(planta1)
  game.addVisual(proyectil1)
  game.addVisual(zombie1)

  //game.onTick(2000, "generarProyectil", {)})
  game.onTick(1000, "tickProyectil", {managerproyectiles.tick()})
  game.onTick(5000,"Generar Zombie", {oleada1.tick()})
  game.onTick(1500, "tickZombie", {managerzombies.tick()})

  game.start()
}


