import zombies.*
import plantas.*
import wollok.game.*
import tablero.*

program PvzGame {
    
  game.title("Plantas vs Zombies")
  game.height(5)
  game.width(9)
  game.cellSize(100)
  // primero hay que dibujar el tablero para que no pise a las plantas y a los zombies visualmente
  tablero.dibujarTablero()
  //game.boardGround("background.png")


  const girasol = new Girasol(image = "girasol.png", vida = 10, costoEnSoles = 25, position = game.at(0,2))
  const planta1 = new LanzaGuisantes(image = "lanzaguisantes.png", vida = 5, costoEnSoles = 100, position = game.at(1,2))
  const zombie1 = new Zombie(position = game.at(7,2))


  zombie1.moverse()
  planta1.disparar()
  game.addVisual(girasol)
  game.addVisual(planta1)
  game.addVisual(zombie1)


  game.start()
}
