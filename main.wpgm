import zombies.*
import plantas.*
import wollok.game.*

program PvzGame {
    
  game.title("Plantas vs Zombies")
  game.height(6)
  game.width(11)
  game.cellSize(66)
  
  game.boardGround("background.png")
  game.start()

  const planta1 = new Planta()
  const zombie1 = new Zombie()

  game.addVisual(planta1)
  game.addVisual(Zombie)


  game.start()
}
