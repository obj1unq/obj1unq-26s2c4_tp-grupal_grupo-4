import zombies.*
import plantas.*
import wollok.game.*
import tablero.*
import oleadas.*
import manager.*
program PvzGame {
//Cosas a implementar: El manager, va a manejar los zombies vivos del nivel, con un metodo que se llame tick, que va a hacer avanzar a todos los zombies vivos, y va a chequear si hay algun zombie muerto para removerlo del juego. 
  game.height(5)
  game.width(9)
  game.cellSize(100)
  // primero hay que dibujar el tablero para que no pise a las plantas y a los zombies visualmente
  tablero.dibujarTablero()
  //game.boardGround("background.png")

  const managerzombies = new ManagerZobies()
  const planta1 = new Planta(position = game.at(0,2))
  const zombie1 = new Zombie()
  const oleada1 = new Oleadas(managerZombies = managerzombies)
  oleada1.agregarCantidadEntidad(3, {i=> new Zombie(velocidad = i)})
  

  game.addVisual(planta1)
  game.onTick(5000,"Generar Zombie", {oleada1.tick()})
  game.onTick(3000, "tick", {managerzombies.tick()})

  game.start()
}
